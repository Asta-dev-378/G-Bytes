<?xml version="1.0" encoding="utf-8"?>
<!-- Native Android splash (API 21+) — orange background + centered GB logo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid orange app-brand background -->
    <item android:drawable="@color/splash_bg" />

    <!-- App icon centered on screen — gravity="center" is honoured from API 21+ -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>

</layer-list>
