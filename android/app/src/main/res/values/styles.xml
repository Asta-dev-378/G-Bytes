<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the process is starting (before Flutter draws first frame) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Orange branded splash background with centred icon -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Remove the status bar / navigation bar flash -->
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Applied after Flutter draws its first frame.
         White background matches the Flutter app background. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
